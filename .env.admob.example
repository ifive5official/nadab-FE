# 필요한 값을 .env.development / .env.production 또는 CI 환경 변수에 추가합니다.
# 운영 활성화는 SSV 콜백 검증을 마친 뒤 진행합니다.
VITE_AD_REWARDS_ENABLED=false
# 플랫폼별 값이 있으면 위 공통 값보다 우선합니다.
VITE_AD_REWARDS_ANDROID_ENABLED=false
VITE_AD_REWARDS_IOS_ENABLED=false
# true이면 Google 데모 광고를 사용합니다. 자체 SSV 콜백 검증에는 사용하지 않습니다.
VITE_ADMOB_USE_DEMO_ADS=false
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_REWARDED_ID=
