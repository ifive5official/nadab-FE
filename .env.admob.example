# 광고 설정 항목 예시입니다. 이 파일 자체는 자동으로 로드되지 않습니다.
# 개발: .env.development.local / 운영: .env.production.local 또는 CI 환경 변수
# 환경별 실제 ID와 적용 순서: docs/ad-rewards.md

# 1. 활성화 — 플랫폼별 값이 공통 값보다 우선합니다.
# 아래 플랫폼별 false를 유지하면 공통 값만 true로 바꿔도 광고가 활성화되지 않습니다.
# 운영 활성화는 양 플랫폼의 SSV 검증을 마친 뒤 진행합니다.
VITE_AD_REWARDS_ENABLED=false
VITE_AD_REWARDS_ANDROID_ENABLED=false
VITE_AD_REWARDS_IOS_ENABLED=false

# 2. 광고 모드 — true: Google 샘플 / false: 아래의 자체 광고 단위
# false는 테스트 모드 해제를 의미하지 않습니다. 등록된 테스트 기기에는 테스트 광고가 제공됩니다.
# Google 샘플 광고로는 자체 광고 단위에 등록한 SSV 콜백을 검증할 수 없습니다.
VITE_ADMOB_USE_DEMO_ADS=false

# 3. Android — 앱 ID(~)는 환경 공통, 광고 단위 ID(/)는 개발·운영별로 구분합니다.
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=

# 4. iOS — 앱 ID(~)는 환경 공통, 광고 단위 ID(/)는 개발·운영별로 구분합니다.
VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_REWARDED_ID=
